### 🏛️ Recurso 1: Gerador de AI-BOM (AI Software Bill of Materials) Estático
**Onde entra:** `aispr_agentic/threat_operations/ai_bom_generator.py`

Em conformidade com as diretrizes de segurança da cadeia de suprimentos de IA (Domínio 2 do seu whitepaper e NIST AI RMF) [cite: 29, 268, 289], o cliente precisa saber exatamente quais componentes de IA estão rodando em sua infraestrutura [cite: 159, 271, 292].

Este script inspeciona o ambiente local ou os arquivos de manifesto do cliente para gerar um arquivo JSON/Markdown padronizado contendo o inventário de modelos, hashes de pesos, datasets locais e dependências de pacotes [cite: 29, 271, 292].

```python
# -*- coding: utf-8 -*-
"""
@jsaccomani's AI-SPR - AI-BOM (AI Software Bill of Materials) Generator
Path: aispr_agentic/threat_operations/ai_bom_generator.py
"""

import os
import json
import hashlib
import pkg_resources
from typing import Dict, Any, List

class AIBOMGenerator:
    def __init__(self, target_directory: str):
        self.target_directory = target_directory

    def _calculate_file_hash(self, file_path: str) -> str:
        """Calculates SHA-256 for local model weights or configurations to prevent poisoning."""
        sha256_hash = hashlib.sha256()
        try:
            with open(file_path, "rb") as f:
                for byte_block in iter(lambda: f.read(4096), b""):
                    sha256_hash.update(byte_block)
            return sha256_hash.hexdigest()
        except Exception:
            return "UNKNOWN_OR_UNREADABLE"

    def scan_python_packages(self) -> List[Dict[str, str]]:
        """Scans the virtual environment for AI/ML library dependencies and vulnerable versions."""
        ai_libs = {"tensorflow", "torch", "transformers", "scikit-learn", "langchain", "llama-index", "google-cloud-aiplatform", "openai"}
        installed_packages = []
        
        for dist in pkg_resources.working_set:
            if dist.project_name.lower() in ai_libs:
                installed_packages.append({
                    "package": dist.project_name,
                    "version": dist.version,
                    "location": dist.location
                })
        return installed_packages

    def discover_local_models(self) -> List[Dict[str, Any]]:
        """Scans directories for active models and serialization files."""
        model_extensions = {".bin", ".onnx", ".pb", ".pt", ".pth", ".safetensors", ".pickle", ".joblib"}
        discovered_models = []

        for root, _, files in os.walk(self.target_directory):
            for file in files:
                ext = os.path.splitext(file).lower()
                if ext in model_extensions:
                    file_path = os.path.join(root, file)
                    discovered_models.append({
                        "model_name": file,
                        "file_path": file_path,
                        "format": ext.replace(".", "").upper(),
                        "size_bytes": os.path.getsize(file_path),
                        "sha256_hash": self._calculate_file_hash(file_path) if os.path.getsize(file_path) < 100 * 1024 * 1024 else "SKIPPED_LARGE_FILE"
                    })
        return discovered_models

    def generate_bom(self) -> Dict[str, Any]:
        """Assembles the final AI-BOM schema aligned with OWASP CycloneDX standards."""
        return {
            "bom_format": "CycloneDX-AI",
            "spec_version": "1.5-AI-SPR",
            "metadata": {
                "author": "@jsaccomani",
                "tool": "AI-SPR Agentic Suite",
                "scan_target": self.target_directory
            },
            "components": {
                "ml_libraries": self.scan_python_packages(),
                "discovered_models": self.discover_local_models()
            }
        }
```

